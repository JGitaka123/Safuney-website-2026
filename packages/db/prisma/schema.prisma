// Safuney Limited — data model (master prompt §5).
//
// Conventions
// - Money is BigInt minor units (KES cents). Never Float/Decimal for money. Format at the edge.
// - Every order state change is an OrderEvent (append-only; enforced by a DB trigger in migration 0002).
// - Stock can never go negative (CHECK constraints in migration 0002).
// - Timestamps are UTC.

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Auth (Auth.js) ─────────────────────────────

enum UserRole {
  CUSTOMER
  B2B_BUYER
  B2B_APPROVER
  SALES
  WAREHOUSE
  FINANCE
  ADMIN
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  phone            String?   @unique // E.164, e.g. +2547XXXXXXXX
  phoneVerified    DateTime?
  image            String?
  role             UserRole  @default(CUSTOMER)
  // Staff only: password + TOTP 2FA. Customers use magic link / OTP and never have these.
  passwordHash     String?
  totpSecret       String?
  isActive         Boolean   @default(true)
  marketingOptInAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  memberships       CustomerMember[]
  orders            Order[]
  reviews           Review[]
  auditLogs         AuditLog[]
  orderEvents       OrderEvent[]
  quotesAuthored    Quote[]          @relation("QuotePricedBy")
  approvedCustomers Customer[]       @relation("CustomerApprovedBy")
  carts             Cart[]
  leadsAssigned     Lead[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────────────────────── Customers ─────────────────────────────

enum CustomerType {
  INDIVIDUAL
  ORGANISATION
}

enum CustomerStatus {
  ACTIVE
  PENDING_CREDIT_APPROVAL
  CREDIT_APPROVED
  SUSPENDED
}

enum MemberRole {
  OWNER
  BUYER
  APPROVER
}

model Customer {
  id                          String         @id @default(cuid())
  type                        CustomerType   @default(INDIVIDUAL)
  status                      CustomerStatus @default(ACTIVE)
  displayName                 String
  // Organisation fields
  legalName                   String?
  kraPin                      String?
  vatNumber                   String?
  billingAddressId            String?        @unique
  creditLimitMinorUnits       BigInt         @default(0)
  creditTermsDays             Int            @default(0)
  // Orders above this amount need an APPROVER; null = never
  approvalThresholdMinorUnits BigInt?
  approvedById                String?
  approvedAt                  DateTime?
  priceListId                 String?
  notes                       String?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt

  billingAddress      Address?               @relation("CustomerBillingAddress", fields: [billingAddressId], references: [id])
  approvedBy          User?                  @relation("CustomerApprovedBy", fields: [approvedById], references: [id])
  priceList           PriceList?             @relation(fields: [priceListId], references: [id])
  members             CustomerMember[]
  addresses           Address[]              @relation("CustomerAddresses")
  orders              Order[]
  quotes              Quote[]
  invoices            Invoice[]
  savedLists          SavedList[]
  wishlists           Wishlist[]
  subscriptions       Subscription[]
  carts               Cart[]
  documentsSubscribed DocumentSubscription[]
  creditApplications  CreditApplication[]

  @@index([priceListId])
  @@index([status])
}

model CustomerMember {
  id         String     @id @default(cuid())
  customerId String
  userId     String
  role       MemberRole @default(BUYER)
  createdAt  DateTime   @default(now())
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([customerId, userId])
  @@index([userId])
}

model Address {
  id            String   @id @default(cuid())
  customerId    String?
  label         String? // "Head office", "Site 2"
  recipientName String
  phone         String // E.164
  county        String
  town          String
  line1         String?
  landmark      String?
  deliveryNotes String?
  lat           Float?
  lng           Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer           Customer? @relation("CustomerAddresses", fields: [customerId], references: [id], onDelete: Cascade)
  billingForCustomer Customer? @relation("CustomerBillingAddress")

  @@index([customerId])
}

model CreditApplication {
  id                       String    @id @default(cuid())
  customerId               String
  legalName                String
  kraPin                   String
  tradeReferences          Json // [{company, contact, phone}]
  documents                Json // [{name, fileUrl}]
  requestedLimitMinorUnits BigInt
  requestedTermsDays       Int
  status                   String    @default("PENDING") // PENDING | APPROVED | REJECTED
  decisionNote             String?
  decidedAt                DateTime?
  createdAt                DateTime  @default(now())
  customer                 Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
}

// ───────────────────────────── Catalogue ─────────────────────────────

/// Colour-coded cleaning zones (industry convention). Used for navigation, filters and badges.
enum ApplicationZone {
  RED // sanitary / washroom
  BLUE // general, low-risk surfaces
  GREEN // food preparation / kitchen
  YELLOW // clinical / isolation
  NONE
}

enum HazardClass {
  NONE
  IRRITANT
  CORROSIVE
  OXIDISER
  FLAMMABLE
  HARMFUL
  ENVIRONMENTAL
}

enum Unit {
  L
  ML
  KG
  G
  PCS
}

model Category {
  id          String          @id @default(cuid())
  parentId    String?
  slug        String          @unique
  name        String
  description String?
  heroImage   String?
  zone        ApplicationZone @default(NONE)
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id               String          @id @default(cuid())
  slug             String          @unique
  name             String
  brand            String?
  shortDescription String
  longDescription  String? // MDX
  howToUse         String? // MDX
  categoryId       String
  tags             String[]        @default([])
  zone             ApplicationZone @default(NONE)
  isActive         Boolean         @default(false)
  hazardClass      HazardClass     @default(NONE)
  /// Structured dilution guidance: [{ "use": "General cleaning", "ratio": 40, "note": "1:40" }]
  dilutionGuidance Json?
  dilutionText     String?
  faq              Json? // [{q, a}]
  sdsDocumentId    String?
  coaDocumentId    String?
  seoTitle         String?
  seoDescription   String?
  needsPoReview    Boolean         @default(true)
  /// Postgres tsvector maintained by trigger (migration 0002); not managed by Prisma.
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  category    Category          @relation(fields: [categoryId], references: [id])
  sdsDocument Document?         @relation("ProductSds", fields: [sdsDocumentId], references: [id])
  coaDocument Document?         @relation("ProductCoa", fields: [coaDocumentId], references: [id])
  variants    ProductVariant[]
  images      ProductImage[]
  documents   ProductDocument[]
  reviews     Review[]
  relatedFrom ProductRelation[] @relation("RelationFrom")
  relatedTo   ProductRelation[] @relation("RelationTo")

  @@index([categoryId, isActive])
  @@index([needsPoReview])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String
  width     Int?
  height    Int?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum RelationKind {
  FREQUENTLY_BOUGHT_TOGETHER
  COMPATIBLE_DISPENSER
  ALTERNATIVE
}

model ProductRelation {
  id            String       @id @default(cuid())
  fromProductId String
  toProductId   String
  kind          RelationKind
  from          Product      @relation("RelationFrom", fields: [fromProductId], references: [id], onDelete: Cascade)
  to            Product      @relation("RelationTo", fields: [toProductId], references: [id], onDelete: Cascade)

  @@unique([fromProductId, toProductId, kind])
}

model ProductVariant {
  id                  String   @id @default(cuid())
  productId           String
  sku                 String   @unique
  packSizeValue       Decimal  @db.Decimal(10, 3)
  unit                Unit
  packLabel           String // "5 L", "15 kg", "12 pcs"
  priceMinorUnits     BigInt   @default(0)
  compareAtMinorUnits BigInt?
  vatRateBps          Int      @default(1600)
  barcode             String?
  weightGrams         Int?
  stockOnHand         Int      @default(0)
  stockReserved       Int      @default(0)
  lowStockThreshold   Int      @default(5)
  isMadeToOrder       Boolean  @default(false)
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceListItems    PriceListItem[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  quoteItems        QuoteItem[]
  movements         InventoryMovement[]
  savedListItems    SavedListItem[]
  wishlistItems     WishlistItem[]
  subscriptionItems SubscriptionItem[]

  @@index([productId])
}

model PriceList {
  id        String          @id @default(cuid())
  name      String
  currency  String          @default("KES")
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     PriceListItem[]
  customers Customer[]
}

model PriceListItem {
  id              String         @id @default(cuid())
  priceListId     String
  variantId       String
  priceMinorUnits BigInt
  minQty          Int            @default(1)
  priceList       PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([priceListId, variantId, minQty])
  @@index([variantId])
}

// ───────────────────────────── Documents ─────────────────────────────

enum DocumentType {
  SDS
  COA
  BROCHURE
  DILUTION_CHART
  CLEANING_SCHEDULE
  OTHER
}

model Document {
  id           String       @id @default(cuid())
  type         DocumentType
  title        String
  version      String       @default("1")
  fileUrl      String
  mimeType     String       @default("application/pdf")
  sizeBytes    Int?
  publishedAt  DateTime     @default(now())
  supersedesId String?      @unique
  createdAt    DateTime     @default(now())

  supersedes    Document?              @relation("DocumentVersions", fields: [supersedesId], references: [id])
  supersededBy  Document?              @relation("DocumentVersions")
  products      ProductDocument[]
  sdsFor        Product[]              @relation("ProductSds")
  coaFor        Product[]              @relation("ProductCoa")
  subscriptions DocumentSubscription[]
}

model ProductDocument {
  productId  String
  documentId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([productId, documentId])
}

model DocumentSubscription {
  id         String   @id @default(cuid())
  customerId String
  documentId String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([customerId, documentId])
}

// ───────────────────────────── Cart ─────────────────────────────

model Cart {
  id         String   @id @default(cuid())
  /// Opaque token stored in an httpOnly cookie for guests
  token      String   @unique
  userId     String?
  customerId String?
  couponCode String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@index([userId])
  @@index([expiresAt])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  qty       Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

// ───────────────────────────── Orders ─────────────────────────────

enum OrderStatus {
  DRAFT
  AWAITING_APPROVAL
  PENDING_PAYMENT
  PAYMENT_FAILED
  PAID
  CONFIRMED
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  MPESA
  CARD
  INVOICE
  COD
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

model Order {
  id                   String         @id @default(cuid())
  number               String         @unique // SFN-YYYYMMDD-NNNN
  customerId           String?
  userId               String?
  guestEmail           String?
  guestPhone           String?
  status               OrderStatus    @default(DRAFT)
  currency             String         @default("KES")
  subtotalMinorUnits   BigInt
  vatMinorUnits        BigInt
  deliveryMinorUnits   BigInt
  discountMinorUnits   BigInt         @default(0)
  totalMinorUnits      BigInt
  paymentMethod        PaymentMethod
  deliveryMethod       DeliveryMethod
  deliveryZoneId       String?
  deliverySlot         String?
  /// Snapshot of the address at order time (Address rows can change later)
  shippingAddress      Json?
  billingAddress       Json?
  poNumber             String?
  couponCode           String?
  notes                String?
  /// Unguessable token that lets a guest open their own order page and poll its status
  accessToken          String         @unique @default(cuid())
  /// Number of payment initiations (STK re-sends, card retries); bounded to stop abuse
  paymentAttempts      Int            @default(0)
  /// Stock reserved for this order is released after this time if it is still unpaid
  reservationExpiresAt DateTime?
  placedAt             DateTime?
  approvedById         String?
  approvedAt           DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  customer         Customer?         @relation(fields: [customerId], references: [id])
  user             User?             @relation(fields: [userId], references: [id])
  deliveryZone     DeliveryZone?     @relation(fields: [deliveryZoneId], references: [id])
  items            OrderItem[]
  events           OrderEvent[]
  payments         Payment[]
  invoices         Invoice[]
  fulfilment       Fulfilment?
  quote            Quote?
  subscriptionRuns SubscriptionRun[]

  @@index([customerId, createdAt])
  @@index([status])
  @@index([userId])
}

model OrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  variantId           String?
  sku                 String
  name                String
  packLabel           String
  unitPriceMinorUnits BigInt
  qty                 Int
  vatRateBps          Int
  lineTotalMinorUnits BigInt // unitPrice * qty, ex VAT
  lineVatMinorUnits   BigInt
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

/// Append-only. UPDATE and DELETE are rejected by a trigger (migration 0002).
model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  type      String // e.g. "status_changed", "payment_received", "note_added"
  actorId   String?
  payload   Json?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor     User?       @relation(fields: [actorId], references: [id])

  @@index([orderId, createdAt])
}

enum PaymentProvider {
  MPESA_DARAJA
  PAYSTACK
  INVOICE
  COD
  MANUAL
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  /// Provider's own reference: M-Pesa receipt, Paystack reference, invoice number, rider's M-Pesa code
  providerRef       String?
  /// Provider-side request id (e.g. Daraja CheckoutRequestID) for status polling
  providerRequestId String?         @unique
  amountMinorUnits  BigInt
  currency          String          @default("KES")
  status            PaymentStatus   @default(INITIATED)
  /// Unique key derived from the callback body; a replay hits the unique index and is ignored
  idempotencyKey    String          @unique
  rawCallback       Json?
  failureReason     String?
  confirmedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([provider, providerRef])
}

/// Raw inbound webhook log, written before any processing so nothing is lost.
model WebhookEvent {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  eventKey    String          @unique // provider-specific unique id used for idempotency
  signatureOk Boolean
  body        Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime        @default(now())
}

enum InvoiceType {
  PROFORMA
  TAX
  CREDIT_NOTE
}

model Invoice {
  id                 String      @id @default(cuid())
  number             String      @unique
  type               InvoiceType
  orderId            String
  customerId         String?
  issuedAt           DateTime    @default(now())
  dueDate            DateTime?
  paidAt             DateTime?
  pdfUrl             String?
  // KRA-compliant snapshot
  sellerName         String
  sellerKraPin       String?
  sellerVatNumber    String?
  buyerName          String
  buyerKraPin        String?
  lines              Json // itemised with VAT per line
  subtotalMinorUnits BigInt
  vatMinorUnits      BigInt
  totalMinorUnits    BigInt
  /// Reserved for eTIMS integration later
  etimsRef           String?
  createdAt          DateTime    @default(now())

  order    Order     @relation(fields: [orderId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([customerId, issuedAt])
}

// ───────────────────────────── Fulfilment ─────────────────────────────

model DeliveryZone {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  counties            String[] @default([])
  /// Fee rules: [{ maxWeightGrams, maxOrderMinorUnits, feeMinorUnits }] evaluated in order; last matching wins
  feeRules            Json
  freeAboveMinorUnits BigInt?
  leadTimeDays        Int      @default(1)
  slots               String[] @default([])
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  orders              Order[]
}

model Fulfilment {
  id                     String    @id @default(cuid())
  orderId                String    @unique
  pickListJson           Json?
  packedAt               DateTime?
  packedById             String?
  dispatchedAt           DateTime?
  riderName              String?
  riderPhone             String?
  deliveredAt            DateTime?
  podName                String?
  podPhotoUrl            String?
  codCollectedMinorUnits BigInt?
  codMpesaRef            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  order                  Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  RESERVATION
  RELEASE
}

model InventoryMovement {
  id        String         @id @default(cuid())
  variantId String
  type      MovementType
  qty       Int // signed delta applied to stockOnHand or stockReserved
  reason    String
  reference String? // order number, GRN, etc.
  actorId   String?
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
}

// ───────────────────────────── Quotes ─────────────────────────────

enum QuoteStatus {
  REQUESTED
  PRICED
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
}

model Quote {
  id           String      @id @default(cuid())
  number       String      @unique
  customerId   String?
  contactName  String
  contactEmail String
  contactPhone String
  status       QuoteStatus @default(REQUESTED)
  notes        String?
  pricedById   String?
  pricedAt     DateTime?
  validUntil   DateTime?
  acceptedAt   DateTime?
  orderId      String?     @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  customer Customer?   @relation(fields: [customerId], references: [id])
  pricedBy User?       @relation("QuotePricedBy", fields: [pricedById], references: [id])
  order    Order?      @relation(fields: [orderId], references: [id])
  items    QuoteItem[]

  @@index([customerId, status])
}

model QuoteItem {
  id                  String          @id @default(cuid())
  quoteId             String
  variantId           String?
  description         String
  qty                 Int
  unitPriceMinorUnits BigInt?
  vatRateBps          Int             @default(1600)
  quote               Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variant             ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([quoteId])
}

// ───────────────────────────── Engagement ─────────────────────────────

model Review {
  id              String   @id @default(cuid())
  productId       String
  userId          String
  rating          Int // 1..5 (CHECK in migration 0002)
  title           String?
  body            String
  isApproved      Boolean  @default(false)
  /// Only set when the user has a DELIVERED order containing this product
  verifiedOrderId String?
  createdAt       DateTime @default(now())
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, isApproved])
}

model Wishlist {
  id         String         @id @default(cuid())
  customerId String
  name       String         @default("Wishlist")
  createdAt  DateTime       @default(now())
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      WishlistItem[]
}

model WishlistItem {
  wishlistId String
  variantId  String
  addedAt    DateTime       @default(now())
  wishlist   Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([wishlistId, variantId])
}

model SavedList {
  id         String          @id @default(cuid())
  customerId String
  name       String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      SavedListItem[]

  @@index([customerId])
}

model SavedListItem {
  savedListId String
  variantId   String
  qty         Int            @default(1)
  savedList   SavedList      @relation(fields: [savedListId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([savedListId, variantId])
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Subscription {
  id             String             @id @default(cuid())
  customerId     String
  status         SubscriptionStatus @default(ACTIVE)
  intervalDays   Int
  nextRunAt      DateTime
  paymentMethod  PaymentMethod
  addressId      String?
  reminderSentAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items          SubscriptionItem[]
  runs           SubscriptionRun[]

  @@index([status, nextRunAt])
}

model SubscriptionItem {
  subscriptionId String
  variantId      String
  qty            Int
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, variantId])
}

model SubscriptionRun {
  id             String       @id @default(cuid())
  subscriptionId String
  orderId        String?
  status         String // CREATED | SKIPPED | FAILED
  error          String?
  ranAt          DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  order          Order?       @relation(fields: [orderId], references: [id])
}

// ───────────────────────────── Promotions ─────────────────────────────

enum DiscountKind {
  PERCENT
  FIXED
}

model Promotion {
  id                 String         @id @default(cuid())
  name               String
  kind               DiscountKind
  /// PERCENT: basis points (1000 = 10 %). FIXED: minor units.
  value              BigInt
  minOrderMinorUnits BigInt?
  categoryIds        String[]       @default([])
  productIds         String[]       @default([])
  customerTypes      CustomerType[] @default([])
  startsAt           DateTime
  endsAt             DateTime
  usageCap           Int?
  usageCount         Int            @default(0)
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  coupons            Coupon[]
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  promotionId    String
  perCustomerCap Int?
  usageCount     Int       @default(0)
  isActive       Boolean   @default(true)
  promotion      Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Leads, content, settings, audit ─────────────────────────────

enum LeadKind {
  CONTACT
  QUOTE_REQUEST
  CALLBACK
  ADVISOR_NO_MATCH
  PLANNER
}

model Lead {
  id           String    @id @default(cuid())
  kind         LeadKind
  name         String
  email        String?
  phone        String?
  organisation String?
  message      String
  payload      Json?
  source       String? // page path
  consentAt    DateTime?
  assignedToId String?
  handledAt    DateTime?
  createdAt    DateTime  @default(now())
  assignedTo   User?     @relation(fields: [assignedToId], references: [id])

  @@index([kind, handledAt])
}

model ContentPage {
  id             String   @id @default(cuid())
  slug           String
  locale         String   @default("en")
  title          String
  body           String // MDX
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean  @default(false)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([slug, locale])
}

model HomepageBlock {
  id        String   @id @default(cuid())
  kind      String // hero | featured_categories | banner | featured_products
  locale    String   @default("en")
  config    Json
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// Key/value site settings editable in admin (VAT display mode, minimum order, etc.)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // e.g. "product.update"
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}
